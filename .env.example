# ── Base de datos (PostgreSQL local con Docker) ──────────────
# Antes de arrancar, levanta el contenedor:
#   docker compose up -d
# Luego corre las migraciones:
#   pnpm db:migrate
DATABASE_URL="postgresql://nbweb:nbweb_dev@localhost:5432/nbweb"

# ── Better Auth ──────────────────────────────────────────────
# Genera uno con:  openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-largo"
BETTER_AUTH_URL="http://localhost:3000"

# ── Admin inicial (usado por prisma/seed.ts) ────────────────
ADMIN_EMAIL="qoritumitd@gmail.com"
ADMIN_PASSWORD="cambia-esta-contraseña"
ADMIN_NAME="Admin"
