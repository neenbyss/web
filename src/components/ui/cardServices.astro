---
interface Props {
  title: string;
  desc: string;
}

const { title, desc } = Astro.props;
---

<article class="p-5 flex flex-col gap-5">
  <header>
    <h1 class="font-bold text-2xl">{title}</h1>
    <p class="font-thin text-sm mt-3">{desc}</p>
  </header>
  <div>
    <button class="p-3 font-bold">Solicitar servicios</button>
  </div>
</article>

<style>
  article {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(
        95deg,
        rgba(92, 109, 255, 0.05) 4.09%,
        rgba(255, 255, 255, 0) 95.91%
      ),
      radial-gradient(
        100% 100% at 49.88% 0%,
        #191622 0%,
        rgba(35, 38, 55, 0.2) 100%
      );
  }

  button {
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: radial-gradient(
      100% 100% at 0% 50.82%,
      #851ad9 0%,
      #5552eb 100%
    );
  }
</style>
