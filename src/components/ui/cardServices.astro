---
interface Props {
  title: string;
  desc: string;
  category?: string;
}

const { title, desc, category } = Astro.props;
---
<article class="card rounded-xl p-4 border border-white/10">
	<span class="text-sm text-secondary ">
		# {category || "category"}
	</span>
	<div class="flex items-center gap-3">
		<h2 class="text-2xl font-black">
			{title}
			<span>&rarr;</span>
		</h2>
	</div>
	<p class="pt-2">
		{desc}
	</p>
</article>

<style>
  article.card {
		background: 
			linear-gradient(95deg, rgba(134, 143, 221, 0.05), rgba(255, 255, 255, 0)),
			radial-gradient(at center top, #191622, rgba(35, 38, 55, 0))
  }
  button {
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: radial-gradient(
      100% 100% at 0% 50.82%,
      #851ad9 0%,
      #5552eb 100%
    );
  }
</style>
