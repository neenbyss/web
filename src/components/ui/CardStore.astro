---
interface Props {
  title: string;
  desc: string;
  price: number;
  img: string;
}

const { img, title, desc, price } = Astro.props;
---

<article class="p-4 flex flex-col gap-3">
  <div class="aspect-video bg-white/20 border border-white/10 overflow-hidden rounded-lg ">
    <img src={img} class="size-full" alt="banner">
  </div>
  <div>
    <h1 class="font-bold text-xl">{title}</h1>
    <p class="font-thin text-sm">{desc}</p>
  </div>
  <div class="mt-2 w-full">
    <button class="p-1 w-full font-bold hover:brightness-75 transition">{price} $</button>
  </div>
</article>

<style>
  article {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(95deg, rgba(159, 78, 198, .05), rgba(255, 255, 255, 0)),
                  radial-gradient(at center top, #362B56, rgbA(24, 28, 48, .2))
  }
  button {
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(90deg, #1a7dd9, #287CDF);
  }
</style>
