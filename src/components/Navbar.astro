---
import DiscordIcon from "@/icons/DiscordIcon.astro"
import TwitterIcon from "@/icons/TwitterIcon.astro"

const Navigation = [
    {
        label: "Inicio",
        href: "/"
    },
    {
        label: "Nosotros",
        href: "/"
    },
    {
        label: "Servicios",
        href: "/"
    },
    {
        label: "Políticas",
        href: "/"
    }
]
---
<header class="bg-transparent backdrop-blur-xl py-2 sticky top-0 z-50">
<nav class="flex justify-between items-center px-4 max-w-7xl mx-auto">
    <div class="h-10">
        <img class="h-full" src="/logo.png" alt="Logo NeenByss">
    </div>
    <div class="flex items-center gap-8">
        <div class="flex items-center gap-6 [&_>_a]:font-bold [&_>_a]:block [&_>_a]:py-6">
            {Navigation.map(({label, href}) => 
                <a 
                    class="block py-6 font-bold hover:text-primary transition-colors"
                    href={href}
                > 
                    {label} 
                </a>
            )}
        </div>
        <div class="flex items-center gap-4 [&_>_a]:block [&_>_a]:py-6 [&_>_a]:transition-colors [&_>_a:hover]:text-primary">
            <a href="/" aria-label="discord-icon">
                <DiscordIcon />
            </a>
            <a href="/" aria-label="twitter-icon">
                <TwitterIcon />
            </a>
        </div>
    </div>
</nav>
</header>