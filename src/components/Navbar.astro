---
const navItems = [
  { label: "Inicio", href: "/" },
  { label: "Servicios", href: "/services" },
  { label: "Proyectos", href: "/portfolio" },
  { label: "Partners", href: "/partners" },
  { label: "Contacto", href: "/#contact" }
];
---

<nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b border-white/10">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2">
        <span class="text-2xl font-bold bg-gradient-to-r from-cyan-400 to-purple-500 bg-clip-text text-transparent">
          Future Software
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-gray-300 hover:text-cyan-400 transition-colors duration-300 text-sm uppercase tracking-wider"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/#contact"
          class="px-6 py-2 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
        >
          <span class="text-white">Iniciar Proyecto</span>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-white p-2 focus:outline-none"
      >
        <svg
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pb-6"
    >
      <div class="flex flex-col space-y-4">
        {navItems.map(item => (
          <a
            href={item.href}
            class="text-gray-300 hover:text-cyan-400 transition-colors duration-300 text-sm uppercase tracking-wider"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/#contact"
          class="px-6 py-2 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300 text-center"
        >
          <span class="text-white">Iniciar Proyecto</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking on a link
  const mobileLinks = mobileMenu?.getElementsByTagName('a');
  if (mobileLinks) {
    Array.from(mobileLinks).forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
      });
    });
  }
</script>