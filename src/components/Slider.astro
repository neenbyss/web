---
interface Props {}
const { } = Astro.props
---

<div class="relative flex flex-shrink-0 gap-5 w-full px-2">
    {Array.from({ length: 3 }).map(_ =>
        <div class="scroller flex-shrink-0 flex gap-5">
            <slot />
        </div>
    )}
</div>

<style>
    .scroller {
        animation: scroll_left 40s linear infinite backwards;
    }

    @keyframes scroll_left {
        0% {
            transform: translate(-100%);
        }

        100% {
            transform: translate(0%);
        }

    }
</style>