---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const services = [
  {
    title: "Desarrollo de páginas web",
    description:
      "Creamos páginas web rápidas, seguras y optimizadas para SEO. Sitios personalizados que impulsan tu negocio.",
    icon: "🌐",
    features: [
      "Sitios web personalizados",
      "Optimización SEO",
      "Diseño responsivo",
    ],
    technologies: ["Next.js", "React.js", "TailwindCSS", "Node.js", "NestJS"],
    gradient: "from-blue-500 to-green-500",
  },
  {
    title: "Desarrollo de aplicaciones web",
    description:
      "Desarrollamos aplicaciones interactivas, seguras y escalables adaptadas a tus necesidades empresariales.",
    icon: "🖥️",
    features: [
      "Aplicaciones escalables",
      "Interfaces intuitivas",
      "Rendimiento optimizado",
    ],
    technologies: ["React.js", "Next.js", "NestJS", "TypeScript", "PostgreSQL"],
    gradient: "from-purple-500 to-indigo-500",
  },
  {
    title: "Bots personalizados para Discord",
    description:
      "Automatizamos tu comunidad con bots avanzados que integran funcionalidades únicas.",
    icon: "🤖",
    features: [
      "Automatización",
      "Comandos personalizados",
      "Integración con APIs",
    ],
    technologies: ["Discord.js", "Node.js", "TypeScript", "MongoDB"],
    gradient: "from-indigo-500 to-purple-500",
  },
  {
    title: "Scripts para servidores FiveM",
    description:
      "Scripts personalizados y optimizados que potencian la experiencia en servidores GTA FiveM.",
    icon: "🎮",
    features: [
      "Funciones únicas",
      "Optimización del rendimiento",
      "Compatibilidad actualizada",
    ],
    technologies: ["Lua", "JavaScript", "MySQL", "FiveM API"],
    gradient: "from-red-500 to-yellow-500",
  },
  {
    title: "Configuración de servidores FiveM",
    description:
      "Configuramos servidores optimizados y seguros para una experiencia estable y fluida en FiveM.",
    icon: "⚙️",
    features: [
      "Rendimiento optimizado",
      "Seguridad avanzada",
      "Soporte técnico continuo",
    ],
    technologies: ["FiveM", "Lua", "JavaScript", "MySQL"],
    gradient: "from-yellow-500 to-orange-500",
  },
  {
    title: "Diseño de interfaces UI/UX",
    description:
      "Diseñamos interfaces visuales atractivas, intuitivas y centradas en el usuario.",
    icon: "🎨",
    features: ["Diseño moderno", "Prototipos interactivos", "Enfoque UX/UI"],
    technologies: ["Figma", "Adobe XD", "Photoshop", "Illustrator"],
    gradient: "from-pink-500 to-purple-500",
  },
];
---

<Layout title="Servicios - Future Software">
  <Navbar />

  <main class="relative min-h-screen bg-[#030014] cyber-grid pt-24">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
      <div
        class="absolute top-1/4 -left-1/4 w-96 h-96 bg-purple-500/30 rounded-full filter blur-[150px]"
      >
      </div>
      <div
        class="absolute top-3/4 -right-1/4 w-96 h-96 bg-blue-500/30 rounded-full filter blur-[150px]"
      >
      </div>
    </div>

    <!-- Header -->
    <section class="relative container mx-auto px-4 py-16">
      <div class="text-center" data-aos="fade-up">
        <h1
          class="text-5xl md:text-6xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500"
        >
          Nuestros Servicios
        </h1>
        <p class="text-gray-400 text-xl max-w-2xl mx-auto">
          Soluciones tecnológicas innovadoras diseñadas para impulsar tu negocio
          hacia el futuro.
        </p>
      </div>
    </section>

    <!-- Services Grid -->
    <section class="relative container mx-auto px-4 pb-32">
      <div class="grid md:grid-cols-2 gap-8">
        {
          services.map((service) => (
            <div
              class="glass rounded-2xl p-8 group hover:bg-white/5 transition-all duration-300"
              data-aos="fade-up"
            >
              <div class="flex items-start gap-4 mb-6">
                <div
                  class={`text-4xl p-4 glass rounded-xl bg-gradient-to-r ${service.gradient} bg-opacity-10`}
                >
                  {service.icon}
                </div>
                <div>
                  <h2 class="text-2xl font-bold text-white mb-2">
                    {service.title}
                  </h2>
                  <p class="text-gray-400">{service.description}</p>
                </div>
              </div>

              <div class="mb-6">
                <h3 class="text-lg font-semibold text-white mb-3">
                  Características
                </h3>
                <ul class="grid grid-cols-1 gap-2">
                  {service.features.map((feature) => (
                    <li class="flex items-center gap-2 text-gray-300">
                      <span class="text-cyan-400">▹</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="text-lg font-semibold text-white mb-3">
                  Tecnologías
                </h3>
                <div class="flex flex-wrap gap-2">
                  {service.technologies.map((tech) => (
                    <span class="px-3 py-1 text-sm glass rounded-full text-cyan-400">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mt-8 text-center">
                <a
                  href="/#contact"
                  class="inline-block px-6 py-3 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
                >
                  <span class="text-white">Solicitar Servicio</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-20 backdrop-blur-sm">
      <div class="container mx-auto px-4">
        <div
          class="max-w-4xl mx-auto glass rounded-2xl p-12 text-center"
          data-aos="fade-up"
        >
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            ¿Listo para transformar tu negocio?
          </h2>
          <p class="text-gray-400 text-lg mb-8 max-w-2xl mx-auto">
            Nuestro equipo de expertos está preparado para ayudarte a
            implementar las soluciones tecnológicas más avanzadas.
          </p>
          <div class="flex justify-center gap-6">
            <a
              href="/#contact"
              class="px-8 py-4 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
            >
              <span class="text-white">Contactar Ahora</span>
            </a>
            <a
              href="/portfolio"
              class="px-8 py-4 border border-white/10 rounded-xl hover:border-cyan-400/50 hover:bg-white/5 transition-all duration-300"
            >
              <span class="text-white">Ver Proyectos</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
