---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  return Object.keys(projects).map(id => ({
    params: { id },
    props: { project: projects[id] }
  }));
}

const { id } = Astro.params;
const { project } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}
---

<Layout title={`${project.title} - Future Software`}>
  <Navbar />
  
  <main class="relative min-h-screen bg-[#030014] cyber-grid pt-24">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
      <div class="absolute top-1/4 -left-1/4 w-96 h-96 bg-purple-500/30 rounded-full filter blur-[150px]"></div>
      <div class="absolute top-3/4 -right-1/4 w-96 h-96 bg-blue-500/30 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative">
      <div class="h-[60vh] relative overflow-hidden">
        <img 
          src={project.image}
          alt={project.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#030014] via-[#030014]/50 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16">
          <div class="container mx-auto">
            <div data-aos="fade-up">
              <div class="flex items-center gap-3 mb-4">
                <span class="px-4 py-1 glass rounded-full text-cyan-400 text-sm">{project.category}</span>
                <span class="text-gray-400">|</span>
                <span class="text-gray-400">{project.completionDate}</span>
              </div>
              <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">{project.title}</h1>
              <p class="text-xl text-gray-300 max-w-3xl">{project.description}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Project Info -->
    <section class="relative py-16">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-3 gap-8">
          <!-- Detalles del Proyecto -->
          <div class="md:col-span-2 space-y-12">
            <!-- Desafío y Solución -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <h2 class="text-2xl font-bold text-white mb-6">El Desafío</h2>
              <p class="text-gray-300 mb-8">{project.challenge}</p>
              
              <h2 class="text-2xl font-bold text-white mb-6">Nuestra Solución</h2>
              <p class="text-gray-300">{project.solution}</p>
            </div>

            <!-- Características -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <h2 class="text-2xl font-bold text-white mb-6">Características Principales</h2>
              <div class="grid md:grid-cols-2 gap-4">
                {project.features.map(feature => (
                  <div class="flex items-center gap-3">
                    <span class="text-cyan-400">▹</span>
                    <span class="text-gray-300">{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <!-- Tecnologías -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <h2 class="text-2xl font-bold text-white mb-6">Tecnologías Utilizadas</h2>
              <div class="grid gap-6">
                {project.technologies.map(tech => (
                  <div>
                    <h3 class="text-lg font-semibold text-cyan-400 mb-2">{tech.name}</h3>
                    <p class="text-gray-300">{tech.description}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Galería -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <h2 class="text-2xl font-bold text-white mb-6">Galería del Proyecto</h2>
              <div class="grid md:grid-cols-2 gap-4">
                {project.gallery.map(image => (
                  <div class="relative aspect-video rounded-xl overflow-hidden group">
                    <img 
                      src={image}
                      alt="Project screenshot"
                      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
                    />
                  </div>
                ))}
              </div>
            </div>

            <!-- Resultados -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <h2 class="text-2xl font-bold text-white mb-6">Resultados</h2>
              <div class="grid md:grid-cols-2 gap-6">
                {project.results.map(result => (
                  <div class="glass rounded-xl p-6 text-center">
                    <p class="text-cyan-400 text-lg">{result}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Sidebar -->
          <div class="space-y-8">
            <!-- Info Card -->
            <div class="glass rounded-2xl p-8  top-24" data-aos="fade-up">
              <div class="space-y-6">
                <div>
                  <h3 class="text-gray-400 mb-2">Cliente</h3>
                  <p class="text-white">{project.client}</p>
                </div>
                <div>
                  <h3 class="text-gray-400 mb-2">Duración</h3>
                  <p class="text-white">{project.duration}</p>
                </div>
                <div>
                  <h3 class="text-gray-400 mb-2">Tecnologías</h3>
                  <div class="flex flex-wrap gap-2">
                    {project.tags.map(tag => (
                      <span class="px-3 py-1 text-sm glass rounded-full text-cyan-400">{tag}</span>
                    ))}
                  </div>
                </div>
                <div class="pt-6">
                  <a
                    href="/#contact"
                    class="block w-full px-6 py-3 text-center neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
                  >
                    <span class="text-white">Iniciar Proyecto Similar</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Testimonial -->
            <div class="glass rounded-2xl p-8" data-aos="fade-up">
              <div class="flex items-center gap-4 mb-6">
                <img 
                  src={project.testimonial.image}
                  alt={project.testimonial.author}
                  class="w-16 h-16 rounded-full object-cover border-2 border-cyan-400"
                />
                <div>
                  <h3 class="text-lg font-semibold text-white">{project.testimonial.author}</h3>
                  <p class="text-cyan-400">{project.testimonial.role}</p>
                </div>
              </div>
              <p class="text-gray-300 italic">"{project.testimonial.content}"</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="relative py-20">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto glass rounded-2xl p-12 text-center" data-aos="fade-up">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            ¿Listo para crear algo increíble?
          </h2>
          <p class="text-gray-400 text-lg mb-8">
            Permítenos ayudarte a llevar tu visión al siguiente nivel con soluciones tecnológicas innovadoras.
          </p>
          <div class="flex flex-wrap justify-center gap-6">
            <a
              href="/#contact"
              class="px-8 py-4 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
            >
              <span class="text-white">Iniciar Proyecto</span>
            </a>
            <a
              href="/portfolio"
              class="px-8 py-4 border border-white/10 rounded-xl hover:border-cyan-400/50 hover:bg-white/5 transition-all duration-300"
            >
              <span class="text-white">Ver Más Proyectos</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>