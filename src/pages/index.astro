<style>
  #main {
    background: radial-gradient(
        50% 75% at 100% 0%,
        rgba(93, 69, 253, 0.2) 0%,
        rgba(22, 22, 22, 0) 100%
      ),
      radial-gradient(
        50% 75% at 0% 100%,
        rgba(93, 69, 253, 0.2) 0%,
        rgba(22, 22, 22, 0) 100%
      ),
      #161616;
  }
  #IA {
    border: 2px solid transparent;
    max-width: 65%;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      white 30%,
      white 70%,
      transparent 100%
    );
  }

  #IA_animation {
    min-width: fit-content;
    display: flex;
    gap: 16px;
    animation: scroll_left 20s linear infinite;
    padding: 0 8px;
  }

  @keyframes scroll_left {
    to {
      transform: translateX(-50%);
    }
  }
</style>
