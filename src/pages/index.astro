</Layout>

<style>
  #IA {
    border: 2px solid transparent;
    max-width: 65%;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      white 30%,
      white 70%,
      transparent 100%
    );
  }

  #IA_animation {
    min-width: fit-content;
    display: flex;
    gap: 16px;
    animation: scroll_left 20s linear infinite;
    padding: 0 8px;
  }

  @keyframes scroll_left {
    to {
      transform: translateX(-50%);
    }
  }
</style>
