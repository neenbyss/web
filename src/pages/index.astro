---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main class="relative min-h-screen bg-[#030014] cyber-grid">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
      <div class="absolute top-1/4 -left-1/4 w-96 h-96 bg-purple-500/30 rounded-full filter blur-[150px]"></div>
      <div class="absolute top-3/4 -right-1/4 w-96 h-96 bg-blue-500/30 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Hero Section -->
    <section class="relative container mx-auto px-4 pt-32 pb-40">
      <div class="text-center z-10 relative" data-aos="fade-up">
        <div class="inline-block mb-4 px-6 py-2 glass rounded-full">
          <!-- <span class="text-cyan-400">2025</span> -->
          <!-- <span class="mx-2 text-gray-400">|</span> -->
          <span class="text-purple-400">Neenbyss</span>
        </div>
        <h1 class="text-6xl md:text-8xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500">
          Tu visión digital
        </h1>
        <p class="text-gray-400 text-xl mb-12 max-w-2xl mx-auto leading-relaxed">
          Desarrollo de páginas y aplicaciones web, bots para Discord que hacen la vida fácil, y servidores FiveM preparados para romperla.
        </p>
        <div class="flex gap-6 justify-center">
          <a href="#contact" class="group px-8 py-4 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300">
            <span class="text-white group-hover:text-cyan-400 transition-colors">Iniciar Proyecto</span>
          </a>
          <a href="#services" class="group px-8 py-4 border border-white/10 rounded-xl hover:border-cyan-400/50 hover:bg-white/5 transition-all duration-300">
            <span class="text-white group-hover:text-cyan-400 transition-colors">Explorar</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="relative py-32 backdrop-blur-sm">
      <div class="container mx-auto px-4">
        <div class="text-center mb-20" data-aos="fade-up">
          <h2 class="text-4xl font-bold text-white mb-4">Servicios Futuristas</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-cyan-500 to-purple-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-12">
          {[
            {
              title: "Páginas web",
              description: "Creamos páginas web rápidas, seguras y optimizadas para SEO. Desarrollamos sitios personalizados que se adaptan a tu negocio y atraen más clientes.",
              icon: "🤖",
              gradient: "from-purple-500 to-pink-500"
            },
            {
              title: "Aplicaciones web",
              description: "Construimos aplicaciones web interactivas y escalables usando tecnologías modernas (Next.js, React.js, NestJS), asegurando velocidad y rendimiento excepcional.",
              icon: "🤖",
              gradient: "from-purple-500 to-pink-500"
            },
            {
              title: "Bots para Discord",
              description: "Desarrollamos bots personalizados para Discord, con funcionalidades únicas, comandos interactivos e integraciones avanzadas para mejorar tu comunidad.",
              icon: "🌌",
              gradient: "from-cyan-500 to-blue-500"
            },
            {
              title: "Scripts para FiveM",
              description: "Creamos scripts únicos para servidores de GTA FiveM, optimizados, seguros y compatibles con las últimas actualizaciones. Dale vida a tu servidor con nuestras soluciones únicas.",
              icon: "⛓️",
              gradient: "from-green-500 to-cyan-500"
            },
            {
              title: "Configuración de servidores FiveM",
              description: "Configuramos y optimizamos servidores de FiveM para asegurar estabilidad, rendimiento y seguridad. Te ayudamos a lanzar tu comunidad rápidamente y sin problemas técnicos.",
              icon: "📡",
              gradient: "from-orange-500 to-red-500"
            },
            {
              title: "Diseño de interfaces (UI/UX)",
              description: "Diseñamos interfaces atractivas, intuitivas y modernas, centradas en la experiencia del usuario. Creamos prototipos en Figma para aplicaciones web, móviles o gaming.",
              icon: "⚛️",
              gradient: "from-blue-500 to-purple-500"
            }
          ].map(service => (
            <div class="group relative" data-aos="fade-up">
              <div class="absolute inset-0 bg-gradient-to-r {service.gradient} rounded-2xl opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
              <div class="relative glass p-8 rounded-2xl hover:transform hover:scale-[1.02] transition-all duration-300  h-80">
                <div class="text-5xl mb-6">{service.icon}</div>
                <h3 class="text-xl font-semibold text-white mb-4">{service.title}</h3>
                <p class="text-gray-400">{service.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="relative py-32 backdrop-blur-sm">
      <div class="container mx-auto px-4">
        <div class="text-center mb-20" data-aos="fade-up">
          <h2 class="text-4xl font-bold text-white mb-4">Proyectos Destacados</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-cyan-500 to-purple-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {[
            {
              title: "MetaVerse Hub",
              description: "Plataforma de realidad virtual para experiencias inmersivas",
              image: "https://images.unsplash.com/photo-1614729939124-032d1e6c9945?w=800&auto=format&fit=crop&q=60",
              tags: ["VR", "3D", "Blockchain"]
            },
            {
              title: "AI Assistant Pro",
              description: "Asistente virtual con procesamiento de lenguaje natural",
              image: "https://images.unsplash.com/photo-1677442136019-21780ecad995?w=800&auto=format&fit=crop&q=60",
              tags: ["AI", "ML", "NLP"]
            },
            {
              title: "CryptoSecure",
              description: "Sistema de seguridad basado en blockchain",
              image: "https://images.unsplash.com/photo-1639762681485-074b7f938ba0?w=800&auto=format&fit=crop&q=60",
              tags: ["Blockchain", "Security"]
            }
          ].map(project => (
            <div class="group relative overflow-hidden rounded-2xl" data-aos="fade-up">
              <div class="relative h-64 overflow-hidden">
                <img 
                  src={project.image} 
                  alt={project.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              </div>
              <div class="absolute bottom-0 left-0 right-0 p-6">
                <h3 class="text-xl font-semibold text-white mb-2">{project.title}</h3>
                <p class="text-gray-300 mb-4">{project.description}</p>
                <div class="flex gap-2">
                  {project.tags.map(tag => (
                    <span class="px-3 py-1 text-sm glass rounded-full text-cyan-400">{tag}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="relative py-32">
      <div class="container mx-auto px-4">
        <div class="text-center mb-20" data-aos="fade-up">
          <h2 class="text-4xl font-bold text-white mb-4">Testimonios</h2>
          <div class="w-24 h-1 bg-gradient-to-r from-cyan-500 to-purple-500 mx-auto"></div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {[
            {
              name: "Guaguito",
              role: "Newliferp",
              content: "Servicio rapido y excelente lo recomiendo mucho. Muy atentos con lo que necesiten y explicacion 10/10 Lo recomiendo mucho.",
              image: "/newlife.webp"
            },
            {
              name: "Mitzunie",
              role: "MitzuStudios",
              content: "Excelente servicio, buena comunicación y organización. Totalmente recomendable para sus futuros proyectos.",
              image: "https://singlecolorimage.com/get/0d304e/100x100"
            },
            {
              name: "Peje",
              role: "Cliente",
              content: "Las 3 B's, los volveria a contratar, buen trato, comunicacion y comprension.",
              image: "https://singlecolorimage.com/get/0d304e/100x100"
            }
          ].map(testimonial => (
            <div class="glass p-8 rounded-2xl relative" data-aos="fade-up">
              <div class="flex items-center gap-4 mb-6">
                <img 
                  src={testimonial.image} 
                  alt={testimonial.name}
                  class="w-16 h-16 rounded-full object-cover border-2 "
                />
                <div>
                  <h3 class="text-lg font-semibold text-white">{testimonial.name}</h3>
                  <p class="text-cyan-400">{testimonial.role}</p>
                </div>
              </div>
              <p class="text-gray-300 italic">"{testimonial.content}"</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="relative py-32">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto glass p-12 rounded-2xl" data-aos="fade-up">
          <h2 class="text-4xl font-bold text-center text-white mb-8">Inicia tu Viaje Digital</h2>
          <form class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <input
                type="text"
                placeholder="Nombre"
                class="w-full px-6 py-4 bg-white/5 rounded-xl text-white border border-white/10 focus:border-cyan-400 focus:outline-none transition-colors"
              />
              <input
                type="email"
                placeholder="Email"
                class="w-full px-6 py-4 bg-white/5 rounded-xl text-white border border-white/10 focus:border-cyan-400 focus:outline-none transition-colors"
              />
            </div>
            <textarea
              placeholder="Tu visión"
              rows="4"
              class="w-full px-6 py-4 bg-white/5 rounded-xl text-white border border-white/10 focus:border-cyan-400 focus:outline-none transition-colors"
            ></textarea>
            <div class="text-center">
              <button
                type="submit"
                class="px-12 py-4 neon-border rounded-xl glass hover:bg-white/10 transition-all duration-300"
              >
                <span class="text-white">Enviar Mensaje</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>