        <div class="flex gap-2 w-full">
          <span
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 flex transition-all place-items-center w-full"
          >
            <h1 class="font-light text-sm text-nowrap">Paginas Webs</h1>
          </span>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
          >
            <h1 class="font-light text-sm text-nowrap">Scripts Fivem</h1>
          </article>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
