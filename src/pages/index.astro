        <div class="grid gap-5 grid-cols-1 lg:grid-cols-2 mt-10">
          <CardServices title="Discord Bots" desc="Desde bots personalizados para moderación y entretenimiento hasta integraciones avanzadas, creamos soluciones inteligentes para tu servidor de Discord." />
