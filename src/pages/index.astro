---
import Layout from "@/layouts/Layout.astro";

import CardServices from "@/components/ui/CardServices.astro";
import CardStore from "@/components/ui/CardStore.astro";

import Slider from "@/components/Slider.astro";

import DiscordIcon from "@/icons/DiscordIcon.astro";
import GlobalIcon from "@/icons/GlobalIcon.astro";
import DesignIcon from "@/icons/DesignIcon.astro";
import FivemIcon from "@/icons/FivemIcon.astro";
import WrenchIcon from "@/icons/WrenchIcon.astro";
import MinecraftIcon from "@/icons/MinecraftIcon.astro";
import BoxIcon from "@/icons/BoxIcon.astro";

const SlidersInfo = [
  {
    label: "Páginas Webs",
    icon: GlobalIcon,
  },
  {
    label: "Diseños UI",
    icon: DesignIcon,
  },
  {
    label: "Mantenimiento",
    icon: WrenchIcon,
  },
  {
    label: "Fivem Scripts",
    icon: FivemIcon,
  },
  {
    label: "Minecraft Plugins",
    icon: MinecraftIcon,
  },
  {
    label: "Discord Apps",
    icon: DiscordIcon,
  },
];
---

<Layout title="Neenbyss | Arquitectos Digitales">
  <main>
    <section id="header" class="h-dvh w-full">
      <div
        class="flex flex-col gap-12 justify-center items-center size-full max-w-7xl mx-auto px-4 -mt-20"
      >
        <h1 class="font-black text-4xl sm:text-6xl text-center">
          ARQUITECTOS DIGITALES
          <span class="text-2xl sm:text-5xl block font-bold py-1">
            <span
              class="bg-gradient-to-r from-[#AFFFFA] to-[#8AA4FF] bg-clip-text text-transparent"
            >
              Diseñamos
            </span>
            Y
            <span
              class="bg-gradient-to-r from-[#C388FF] to-[#FF613F] bg-clip-text text-transparent"
            >
              Desarrollamos
            </span>
          </span>
        </h1>
        <div id="IA" class="w-full px-4 overflow-hidden">
          <Slider>
            {
              SlidersInfo.map(({ label, icon }) => {
                const Icon = icon;
                return (
                  <span class="flex items-center gap-2 text-nowrap bg-gradient-to-r from-[#2c273b] to-[#181F2F px-4 py-2 rounded-lg border border-white/10 w-full">
                    <Icon />
                    {label}
                  </span>
                );
              })
            }
          </Slider>
        </div>
      </div>
    </section>

    <section class="py-32 bg-gradient-to-r from-[rgba(23,19,31,0.5)] to-[rgb(49,49,77,0.5)]">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center">
          <h3 class="text-primary text-2xl font-black">NOSOTROS</h3>
          <h2 class="text-4xl font-black">OFRECEMOS UNA GRAN EXPERIENCIA</h2>
          <p class="pt-3">
            En NeenByss, nos especializamos en convertir tus ideas en realidad a
            través del diseño y desarrollo. Ya sea que necesites crear una
            interfaz desde cero o darle un nuevo diseño a una existente, estamos
            aquí para ayudarte. Además, si requieres llevar ese diseño al
            desarrollo, ¡también estamos preparados para comenzar!
          </p>
        </div>

        <div id="us-box" class="p-8 rounded-xl mt-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <div class="">
            <div class="text-primary">
              <BoxIcon />
              <h4 class="text-xl font-bold">Desarrollo de software</h4>
            </div>
            <p class="pt-1">
              Soluciones personalizadas y adaptadas a tus necesidades.
            </p>
          </div>
          <div class="">
            <div class="text-primary">
              <BoxIcon />
              <h4 class="text-xl font-bold">Diseño UI/UX</h4>
            </div>
            <p class="pt-1">
              Diseñamos y rediseñamos interfaces, además de crear tu nuevo branding.
            </p>
          </div>
          <div class="">
            <div class="text-primary">
              <BoxIcon />
              <h4 class="text-xl font-bold">Nuestro equipo</h4>
            </div>
            <p class="pt-1">
              Experiencia y amabilidad para guiarte en todo lo que necesitas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="services" class="py-40">
      <div class="max-w-6xl mx-auto px-4">
        <div class="text-center">
          <h2 class="font-black text-4xl"> SERVICIOS </h2>
          <p class="pt-1">
            Ofrecemos una gama de servicios especializados para potenciar tu
            presencia en línea y optimizar tus herramientas digitales.
          </p>
        </div>

        <div class="grid gap-5 grid-cols-1 lg:grid-cols-2 mt-10">
          <CardServices
            
            title="Discord Bots"
            desc="Desde bots personalizados para moderación y entretenimiento hasta integraciones avanzadas, creamos soluciones inteligentes para tu servidor de Discord."
          />
          <CardServices
            title="Diseño de para Web y FiveM"
            desc="ransformamos tus ideas en interfaces web modernas y amigables, tanto para aplicaciones convencionales como para entornos de FiveM."
          />
          <CardServices
            title="Páginas Web"
            desc="Desarrollamos sitios web a medida que cautivan a tus visitantes y reflejan la identidad única de tu marca."
          />
        </div>
      </div>

      <!-- <div class="mt-28 max-w-6xl m-auto px-4">
        <h1 class="text-center font-black uppercase text-4xl">
          nuestra tienda
        </h1>
        <h2 class="text-center text-sm mt-2">
          ofrecemos una gama de servicios especializados para potenciar tu
          presencia en línea y optimizar tus herramientas digitales.
        </h2>
        <div class="grid gap-5 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mt-10">
          <CardStore
            img=""
            title="Discord Ticket"
            desc="Ten un bonito bot de tickets para tu comunidad de discord, con todos los comandos esenciales, tickets por canales o por hilos, puedes cambiar los mensajes, el sistema por botones o por menus"
            price={29.0}
          />
          <CardStore
            img=""
            title="Discord Ticket"
            desc="Ten un bonito bot de tickets para tu comunidad de discord, con todos los comandos esenciales, tickets por canales o por hilos, puedes cambiar los mensajes, el sistema por botones o por menus"
            price={29.0}
          />
          <CardStore
            img=""
            title="Discord Ticket"
            desc="Ten un bonito bot de tickets para tu comunidad de discord, con todos los comandos esenciales, tickets por canales o por hilos, puedes cambiar los mensajes, el sistema por botones o por menus"
            price={29.0}
          />
        </div>
      </div> -->
    </section>

    <section class="py-44">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center">
          <h2 class="font-black text-4xl"> NUESTRO EQUIPO </h2>
          <p class="pt-1">
            Nuestro equipo está altamente enfocado y especializado en su campo, lo que nos permite ofrecer un trabajo de excelente calidad.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4 mt-8">

          <div class="team-card p-4 bg-[rgba(36,42,54,0.1)] border border-white/10 rounded-xl shadow-[0px_0px_20px_0px_rgba(86,73,166,0.25)]">
            <div class="flex items-center gap-2">
              <div class="rounded-full size-12 bg-white overflow-hidden">
                <img 
                  alt="avatar"
                  src="user"
                  class="size-full"
                />
              </div>

              <div class="flex flex-col gap-0">
                <h4 class="font-black"> Kamerr Ezz </h4>
                <span class="text-sm opacity-50"> @kamerrezz </span>
              </div>
            </div>

            <div class="mt-2">
              <span class="text-primary text-sm">
                # Founder
              </span>

              <p class=" line-clamp-3">
                Desarrollador de software y diseñador grafico, CEO de Zeew Space - un espacio para aprender
              </p>
            </div>
          </div>

          <div class="team-card p-4 bg-[rgba(36,42,54,0.1)] border border-white/10 rounded-xl shadow-[0px_0px_20px_0px_rgba(86,73,166,0.25)]">
            <div class="flex items-center gap-2">
              <div class="rounded-full size-12 bg-white overflow-hidden">
                <img 
                  alt="avatar"
                  src="user"
                  class="size-full"
                />
              </div>

              <div class="flex flex-col gap-0">
                <h4 class="font-black"> DISPLAY NAME </h4>
                <span class="text-sm opacity-50"> @username </span>
              </div>
            </div>

            <div class="mt-2">
              <span class="text-primary text-sm">
                # Desarrollador
              </span>

              <p class=" line-clamp-3">
                Lorem ipsum dolor sit amet consectetur, adipisicing elit. Sed maiores quia voluptatem veniam at ut odit, doloremque accusamus tenetur facilis? Minima tempora est, laudantium beatae magni quam itaque a eveniet.
              </p>
            </div>
          </div>

          <div class="team-card p-4 bg-[rgba(36,42,54,0.1)] border border-white/10 rounded-xl shadow-[0px_0px_20px_0px_rgba(86,73,166,0.25)]">
            <div class="flex items-center gap-2">
              <div class="rounded-full size-12 bg-white overflow-hidden">
                <img 
                  alt="avatar"
                  src="user"
                  class="size-full"
                />
              </div>

              <div class="flex flex-col gap-0">
                <h4 class="font-black"> DISPLAY NAME </h4>
                <span class="text-sm opacity-50"> @username </span>
              </div>
            </div>

            <div class="mt-2">
              <span class="text-primary text-sm">
                # Desarrollador
              </span>

              <p class=" line-clamp-3">
                Lorem ipsum dolor sit amet consectetur, adipisicing elit. Sed maiores quia voluptatem veniam at ut odit, doloremque accusamus tenetur facilis? Minima tempora est, laudantium beatae magni quam itaque a eveniet.
              </p>
            </div>
          </div>

        </div>

      </div>

    </section>
  </main>
</Layout>

<style>
  #header {
    position: relative;
    background-image: url("/pattern.png");
    background-repeat: no-repeat;
    background-size: auto 80%;
    background-position: center;
  }

  #header::before {
    content: "";
    background: radial-gradient(
      at right bottom,
      rgba(173, 0, 255, 0.15),
      rgba(0, 0, 0, 0) 80%
    );
    background-repeat: no-repeat;
    width: 100%;
    height: 100%;
    position: absolute;
    z-index: -1;
  }
  #cotizar {
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: radial-gradient(
      100% 100% at 0% 50.82%,
      #1a5bd9 0%,
      #287cdf 100%
    );
  }
  #banner {
    background:
      linear-gradient(
        90deg,
        rgba(22, 22, 22, 0.48) 0%,
        rgba(33, 44, 71, 0.48) 100%
      ),
      url("data:image/svg+xml,%3Csvg width='64' height='64' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M8 16c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm0-2c3.314 0 6-2.686 6-6s-2.686-6-6-6-6 2.686-6 6 2.686 6 6 6zm33.414-6l5.95-5.95L45.95.636 40 6.586 34.05.636 32.636 2.05 38.586 8l-5.95 5.95 1.414 1.414L40 9.414l5.95 5.95 1.414-1.414L41.414 8zM40 48c4.418 0 8-3.582 8-8s-3.582-8-8-8-8 3.582-8 8 3.582 8 8 8zm0-2c3.314 0 6-2.686 6-6s-2.686-6-6-6-6 2.686-6 6 2.686 6 6 6zM9.414 40l5.95-5.95-1.414-1.414L8 38.586l-5.95-5.95L.636 34.05 6.586 40l-5.95 5.95 1.414 1.414L8 41.414l5.95 5.95 1.414-1.414L9.414 40z' fill='%239C92AC' fill-opacity='0.4' fill-rule='evenodd'/%3E%3C/svg%3E")
        0% 0% / 114.0625px 114.0625px repeat;
  }
  #IA {
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      white 30%,
      white 70%,
      transparent 100%
    );
  }

  #services {
    background: radial-gradient(49.93% 49.93% at 50% 50.07%, rgba(114, 90, 210, 0.15) 0%, rgba(114, 57, 158, 0.00) 100%);
    background-repeat: no-repeat;
    background-position: center;
  }

  #us-box {
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: linear-gradient(
      94deg,
      rgba(39, 60, 113, 0.3) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    box-shadow: 0px 0px 40px 0px rgba(39, 62, 97, 0.25);
  }

  .team-card {
    box-shadow: 0px 0px 20px 0px rgba(86, 73, 166, 0.25);
  }
</style>
