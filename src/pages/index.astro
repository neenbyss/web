---
import Layout from "../layouts/Layout.astro";
import CardServices from "../components/ui/cardServices.astro";
import CardStore from "../components/ui/CardStore.astro";
---

<Layout title="Arquitectos digitales">
  <header
    class="min-h-[calc(100vh_-_3rem)] w-screen flex flex-col gap-8 justify-center items-center"
  >
    <section class="font-bold text-center text-5xl">
      <h1>Arquitectos digitales</h1>
      <div>
        <span class="text-dull-lavender-400">diseñamos</span> y <span
          class="text-dull-lavender-400">desarrollamos</span
        >
      </div>
    </section>
    <section id="IA">
      <div id="IA_animation">
        <div class="flex gap-2 w-full">
          <span
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 flex transition-all place-items-center w-full"
          >
            <h1 class="font-light text-sm text-nowrap">Paginas Webs</h1>
          </span>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
          >
            <h1 class="font-light text-sm text-nowrap">Scripts Fivem</h1>
          </article>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
          >
            <h1 class="font-light text-sm text-nowrap">Bot Discord</h1>
          </article>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
          >
            <h1 class="font-light text-sm text-nowrap">Plugins Minecraft</h1>
          </article>
          <article
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 grid transition-all place-items-center w-fit"
          >
            <h1 class="font-light text-sm text-nowrap">Mantenimiento</h1>
          </article>
        </div>
        <div class="flex gap-2 w-full">
          <article
            aria-hidden
            class="bg-woodsmoke-950 p-2 rounded border border-electric-violet-500/50 flex transition-all place-items-center w-full"
          >
