---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const categories = [
  { id: 'web', name: 'Aplicaciones Web', icon: '🌐' },
  { id: 'design', name: 'Diseño UI/UX', icon: '🎨' },
  { id: 'fivem', name: 'FiveM', icon: '🚗' },
];

const projects = [
  {
    id: "neenbyssrp",
    title: "Neenbyss Roleplay",
    description: "Servidor de roleplay Fivem, con scripts exclusivos y de tienda exclusiva",
    image: "https://images.unsplash.com/photo-1614729939124-032d1e6c9945?w=800&auto=format&fit=crop&q=60",
    category: "fivem",
    tags: ["FiveM"],
    link: "/project/neenbyssrp"
  }
];

let activeCategory = 'all';
---

<Layout title="Portafolio - Neenbyss">
  <Navbar />
  
  <main class="relative min-h-screen bg-[#030014] cyber-grid pt-24">
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
      <div class="absolute top-1/4 -left-1/4 w-96 h-96 bg-purple-500/30 rounded-full filter blur-[150px]"></div>
      <div class="absolute top-3/4 -right-1/4 w-96 h-96 bg-blue-500/30 rounded-full filter blur-[150px]"></div>
    </div>

    <!-- Header -->
    <section class="relative container mx-auto px-4 py-16">
      <div class="text-center" data-aos="fade-up">
        <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-purple-500 to-pink-500">
          Nuestro Portafolio
        </h1>
        <p class="text-gray-400 text-xl max-w-2xl mx-auto">
          Explorá nuestra colección de proyectos innovadores en diferentes áreas de la tecnología.
        </p>
      </div>
    </section>

    <!-- Categories -->
    <section class="relative container mx-auto px-4 mb-16">
      <div class="flex flex-wrap justify-center gap-4" data-aos="fade-up">
        <button
          class="category-btn px-6 py-3 rounded-xl glass text-white hover:text-cyan-400 transition-all duration-300 active"
          data-category="all"
        >
          🌟 Todos
        </button>
        {categories.map(category => (
          <button
            class="category-btn px-6 py-3 rounded-xl glass text-white hover:text-cyan-400 transition-all duration-300"
            data-category={category.id}
          >
            {category.icon} {category.name}
          </button>
        ))}
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="relative container mx-auto px-4 pb-32">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map(project => (
          <div 
            class="project-card group relative overflow-hidden rounded-2xl"
            data-category={project.category}
            data-aos="fade-up"
          >
            <div class="relative h-64 overflow-hidden">
              <img 
                src={project.image} 
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h3 class="text-xl font-semibold text-white mb-2">{project.title}</h3>
              <p class="text-gray-300 mb-4">{project.description}</p>
              <div class="flex flex-wrap gap-2">
                {project.tags.map(tag => (
                  <span class="px-3 py-1 text-sm glass rounded-full text-cyan-400">{tag}</span>
                ))}
              </div>
            </div>
            <a 
              href={project.link}
              class="absolute inset-0 z-10 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/50 backdrop-blur-sm"
            >
              <span class="px-6 py-3 glass rounded-xl text-white border border-white/20 hover:border-cyan-400/50 transition-colors">
                Ver Detalles
              </span>
            </a>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .category-btn.active {
    @apply border border-cyan-400/50 text-cyan-400;
  }
</style>

<script>
  const categoryButtons = document.querySelectorAll('.category-btn');
  const projectCards = document.querySelectorAll('.project-card');

  categoryButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active button
      categoryButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      // Filter projects
      const category = button.getAttribute('data-category');
      projectCards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>