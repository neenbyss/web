---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import '@/styles/global.css';
import '@/styles/markdown.css';

interface Props {
    frontmatter: any;
}

const { frontmatter } = Astro.props;
const desc = frontmatter?.description ?? "En NeenByss, nos especializamos en convertir tus ideas en realidad a través del diseño y desarrollo. Ya sea que necesites crear una interfaz desde cero o darle un nuevo diseño a una existente, estamos aquí para ayudarte. Además, si requieres llevar ese diseño al desarrollo, ¡también estamos preparados para comenzar!"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="description" content=`${desc}`>
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-outfit text-wild-sand-50 min-h-screen overflow-x-hidden">
    <Navbar />
    <main class="m-auto max-w-5xl py-20 px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    font-family: "Outfit", sans-serif;
  }
</style>

