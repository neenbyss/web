---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import '@/styles/global.css';
import '@/styles/markdown.css';

interface Props {
    frontmatter: any;
}

const { frontmatter } = Astro.props;
const desc = frontmatter?.description ?? "En Neenbyss creamos soluciones digitales personalizadas: desarrollo web profesional, bots para Discord y servidores FiveM optimizados. ¡Impulsa tu proyecto ahora!"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- Primary Meta Tags -->
    <title>{frontmatter.title}</title>
    <meta name="title" content=`${frontmatter.title}` />
    <meta name="description" content=`${desc}` />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://neenbyss.com/" />
    <meta property="og:title" content=`${frontmatter.title}` />
    <meta property="og:description" content=`${desc}` />
    <meta property="og:image" content="https://neenbyss.com/images/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://neenbyss.com/" />
    <meta property="twitter:title" content=`${frontmatter.title}` />
    <meta property="twitter:description" content=`${desc}` />
    <meta property="twitter:image" content="https://neenbyss.com/images/twitter-card.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-outfit text-wild-sand-50 min-h-screen overflow-x-hidden">
    <Navbar />
    <main class="m-auto max-w-5xl py-20 px-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    font-family: "Outfit", sans-serif;
  }
</style>

