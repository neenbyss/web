---
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import '@/styles/global.css';
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="En NeenByss, nos especializamos en convertir tus ideas en realidad a través del diseño y desarrollo. Ya sea que necesites crear una interfaz desde cero o darle un nuevo diseño a una existente, estamos aquí para ayudarte. Además, si requieres llevar ese diseño al desarrollo, ¡también estamos preparados para comenzar!" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content="Neenbyss | Desarrollo Web, Bots Discord y Servidores FiveM Personalizados" />
    <meta name="description" content="En Neenbyss creamos soluciones digitales personalizadas: desarrollo web profesional, bots para Discord y servidores FiveM optimizados. ¡Impulsa tu proyecto ahora!" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://neenbyss.com/" />
    <meta property="og:title" content="Neenbyss | Desarrollo Web, Bots Discord y Servidores FiveM Personalizados" />
    <meta property="og:description" content="En Neenbyss creamos soluciones digitales personalizadas: desarrollo web profesional, bots para Discord y servidores FiveM optimizados. ¡Impulsa tu proyecto ahora!" />
    <meta property="og:image" content="https://neenbyss.com/images/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://neenbyss.com/" />
    <meta property="twitter:title" content="Neenbyss | Desarrollo Web, Bots Discord y Servidores FiveM Personalizados" />
    <meta property="twitter:description" content="En Neenbyss creamos soluciones digitales personalizadas: desarrollo web profesional, bots para Discord y servidores FiveM optimizados. ¡Impulsa tu proyecto ahora!" />
    <meta property="twitter:image" content="https://neenbyss.com/images/twitter-card.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-outfit text-wild-sand-50 min-h-screen overflow-x-hidden">
    <Navbar />
    <slot />
    <Footer />
  </body>
</html>

<style>
  body {
    font-family: "Outfit", sans-serif;
  }
</style>

